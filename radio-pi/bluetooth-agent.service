[Unit]
Description=Philco Bluetooth pairing agent + volume-gated adapter power
After=bluetooth.service network-online.target
Requires=bluetooth.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/bin/bluetooth-agent.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
