

body
  margin 0px
  padding 0px
  overflow hidden
  transform rotate(.5deg) scale(.89,.8) translate(-4px,22px)

#content
  width 800px
  height 480px
  border 2px solid red
  overflow hidden
  
#faceplate
  position absolute
  width 900px
  height 540px
  top -30px
  left -50px

#pointer
  width 100%
  height auto
  top 10px
  left -20px
  transform-origin calc(50% + 18px) calc(50% + 8px);
  position absolute
  
.menu.middle2
  display block
  width 100%
  height 190px
  display flex
  justify-content stretch
  
.menu.middle2 .button
  flex 0 0 150px
  height 100%
  z-index 100
  
.menu.middle2 .dial
  flex 1 1 100%
  height 100%
  z-index 100
  
.menu.middle1
  display block
  width 100%
  height 235px
  display flex
  justify-content stretch
  
.menu.middle1 .button
  flex 0 0 150px
  height 100%
  z-index 100
  
.menu.middle1 .dial
  flex 1 1 100%
  height 100%
  z-index 100
  
.menu.top
  display block
  width 100%
  height 100px
  display flex
  justify-content stretch
  
.menu.top .button
  flex 1 1 100%
  height 100%
  z-index 100

.pairing-screen
  width 800px
  height 480px
  background #111
  color white
  display flex
  flex-direction column
  align-items center
  justify-content center
  text-align center

.pairing-code
  font-size 96px
  letter-spacing 12px
  font-family monospace

.pairing-label
  font-size 24px
  margin-top 20px
  padding 0 60px

.pairing-buttons
  display flex
  margin-top 50px

.pairing-button
  font-size 28px
  padding 20px 60px
  margin 0 20px
  border-radius 8px
  color white

.pairing-button.pair
  background #2e7d32

.pairing-button.cancel
  background #c62828

